{
    "log": {
        "loglevel": "warning"
    },
    "inbounds": [
        {
            "listen": "@xhttp",
            "protocol": "vless",
            "settings": {
                "decryption": "none",
                "clients": [
                    {
                        "id": "<paste client id here>", // xray uuid
                        "email": "client"
                    }
                ]
            },
            "streamSettings": {
                "network": "xhttp",
                "xhttpSettings": {
                    "path": "/<paste xhttp path here>" // < /dev/urandom tr -dc a-z0-9 | head -c${1:-8};echo;
                }
            },
            "tag": "xhttp-first-hop"
        },
        {
            "listen": "0.0.0.0",
            "port": 443,
            "protocol": "vless",
            "settings": {
                "decryption": "none",
                "fallbacks": [
                    {
                        "dest": "@xhttp"
                    }
                ]
            },
            "streamSettings": {
                "network": "tcp",
                "security": "reality",
                "realitySettings": {
                    "target": "8001",
                    "xver": 1,
                    "serverNames": [
                        "your-domain.com"
                    ],
                    "privateKey": "<paste private key here>", // xray x25519
                    "shortIds": [
                        ""
                    ]
                }
            }
        }
    ],
    "outbounds": [
        {
            "protocol": "vless",
            "settings": {
                "vnext": [
                    {
                        "address": "<paste exit node vps ip here>",
                        "port": 443,
                        "users": [
                            {
                                "id": "<paste exit node vps client id here>", // xray uuid
                                "encryption": "none",
                                "flow": "xtls-rprx-vision"
                            }
                        ]
                    }
                ]
            },
            "streamSettings": {
                "network": "tcp",
                "security": "reality",
                "realitySettings": {
                    "fingerprint": "chrome",
                    "serverName": "gstatic.com",
                    "publicKey": "<paste exit node vps public key here>", // xray x25519
                    "spiderX": "",
                    "shortId": ""
                }
            },
            "tag": "next-hop"
        }
    ],
    "routing": {
        "rules": [
            {
                "inboundTag": "xhttp-first-hop",
                "outboundTag": "next-hop"
            }
        ]
    }
}